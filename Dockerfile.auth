# Dockerfile for Auth Service
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig*.json ./
COPY nest-cli.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY apps/auth ./apps/auth
COPY libs ./libs

# Generate Prisma client for auth (schema in apps/auth/src/prisma, URL only for generate)
RUN AUTH_DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" npx prisma generate --schema=apps/auth/src/prisma/schema.prisma

# Build the application
RUN npm run build:auth

# Production stage
FROM node:20-alpine

WORKDIR /app

# Run as non-root user (node user exists in node image)
RUN addgroup -g 1001 -S appgroup && adduser -S appuser -u 1001 -G appgroup

# Copy package files
COPY package*.json ./

# Install only production dependencies
RUN npm ci --omit=dev && npm cache clean --force

# Copy generated Prisma client from builder
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Own app dir for non-root user
RUN chown -R appuser:appgroup /app

USER appuser

# Expose port
EXPOSE 3010

# Start the application (AUTH_DATABASE_URL must be set at runtime)
CMD ["node", "dist/apps/auth/main.js"]
