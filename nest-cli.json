{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/auth",
  "sourceRoot": "apps/auth/src",
  "compilerOptions": {
    "plugins": [],
    "assets": [],
    "watchAssets": false,
    "tsConfigPath": "apps/auth/tsconfig.app.json"
  },
  "projects": {
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "listing": {
      "type": "application",
      "root": "apps/listing",
      "entryFile": "main",
      "sourceRoot": "apps/listing/src",
      "compilerOptions": {
        "tsConfigPath": "apps/listing/tsconfig.app.json"
      }
    },
    "moderation": {
      "type": "application",
      "root": "apps/moderation",
      "entryFile": "main",
      "sourceRoot": "apps/moderation/src",
      "compilerOptions": {
        "tsConfigPath": "apps/moderation/tsconfig.app.json"
      }
    },
    "media": {
      "type": "application",
      "root": "apps/media",
      "entryFile": "main",
      "sourceRoot": "apps/media/src",
      "compilerOptions": {
        "tsConfigPath": "apps/media/tsconfig.app.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}
