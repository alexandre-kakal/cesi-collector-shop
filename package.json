{
  "name": "cesi-collector-shop",
  "version": "1.0.0",
  "description": "Cesi Collector Shop - NestJS Monorepo",
  "private": true,
  "scripts": {
    "build:auth": "nest build auth",
    "build:listing": "nest build listing",
    "build:moderation": "nest build moderation",
    "build:media": "nest build media",
    "start:auth": "node dist/apps/auth/main",
    "start:listing": "node dist/apps/listing/main",
    "start:moderation": "node dist/apps/moderation/main",
    "start:media": "node dist/apps/media/main",
    "start:auth:dev": "nest start auth --watch",
    "start:listing:dev": "nest start listing --watch",
    "start:moderation:dev": "nest start moderation --watch",
    "start:media:dev": "nest start media --watch",
    "start:all:dev": "concurrently \"npm run start:auth:dev\" \"npm run start:listing:dev\" \"npm run start:moderation:dev\" \"npm run start:media:dev\"",
    "prisma:generate:auth": "prisma generate --config apps/auth/prisma.config.ts",
    "prisma:generate:listing": "prisma generate --config apps/listing/prisma.config.ts",
    "prisma:generate:moderation": "prisma generate --config apps/moderation/prisma.config.ts",
    "prisma:generate:media": "prisma generate --config apps/media/prisma.config.ts",
    "prisma:migrate:auth": "prisma migrate dev --config apps/auth/prisma.config.ts --name",
    "prisma:migrate:listing": "prisma migrate dev --config apps/listing/prisma.config.ts --name",
    "prisma:migrate:moderation": "prisma migrate dev --config apps/moderation/prisma.config.ts --name",
    "prisma:migrate:media": "prisma migrate dev --config apps/media/prisma.config.ts --name",
    "prisma:deploy:auth": "prisma migrate deploy --config apps/auth/prisma.config.ts",
    "prisma:deploy:listing": "prisma migrate deploy --config apps/listing/prisma.config.ts",
    "prisma:deploy:moderation": "prisma migrate deploy --config apps/moderation/prisma.config.ts",
    "prisma:deploy:media": "prisma migrate deploy --config apps/media/prisma.config.ts",
    "prisma:studio:auth": "prisma studio --config apps/auth/prisma.config.ts",
    "prisma:studio:listing": "prisma studio --config apps/listing/prisma.config.ts",
    "prisma:studio:moderation": "prisma studio --config apps/moderation/prisma.config.ts",
    "prisma:studio:media": "prisma studio --config apps/media/prisma.config.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/core": "^11.1.14",
    "@nestjs/microservices": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/config": "^4.0.3",
    "@nestjs/throttler": "^6.5.0",
    "better-auth": "^1.4.18",
    "@prisma/client": "^7.4.1",
    "@prisma/adapter-pg": "^7.4.1",
    "prisma": "^7.4.1",
    "ioredis": "^5.3.2",
    "amqplib": "^0.10.9",
    "amqp-connection-manager": "^5.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "class-validator": "^0.14.3",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "uuid": "^13.0.0",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "minio": "^8.0.6",
    "mime-types": "^3.0.2",
    "dotenv": "^16.4.5"
  },
  "overrides": {
    "lodash": "^4.17.23",
    "minimatch": "^10.2.1",
    "fast-xml-parser": "^5.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.14",
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": ["<rootDir>/apps/", "<rootDir>/libs/"],
    "moduleNameMapper": {
      "^@app/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    }
  }
}
