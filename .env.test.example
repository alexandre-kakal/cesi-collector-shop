# Example Test Environment Configuration
# Copy this file to create .env.test files for each service

# ============================================
# Common Configuration (All Services)
# ============================================

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# JWT Configuration (RS256 - requis pour les tests d'autorisation)
# ============================================
# Les apps listing/moderation/media vérifient les JWT avec JWT_PUBLIC_KEY (RS256).
# Les tokens de test sont signés avec JWT_PRIVATE_KEY (voir test/helpers/auth.helper.ts).
#
# Si JWT_PUBLIC_KEY / JWT_PRIVATE_KEY ne sont pas définis ici, jest.setup.integration.js
# charge automatiquement test/keys/test-public.pem et test/keys/test-private.pem.
# Vous pouvez générer de nouvelles clés avec:
#   openssl genrsa -out test/keys/test-private.pem 2048
#   openssl rsa -in test/keys/test-private.pem -pubout -out test/keys/test-public.pem

# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ============================================
# Auth Service (.env.test)
# ============================================
AUTH_PORT=3011
AUTH_DATABASE_URL=postgresql://collector:collector123@localhost:5432/cesi_auth_test

# ============================================
# Listing Service (.env.test)
# ============================================
LISTING_PORT=3021
LISTING_DATABASE_URL=postgresql://collector:collector123@localhost:5433/cesi_listing_test

# ============================================
# Moderation Service (.env.test)
# ============================================
MODERATION_PORT=3031
MODERATION_DATABASE_URL=postgresql://collector:collector123@localhost:5434/cesi_moderation_test

# ============================================
# Media Service (.env.test)
# ============================================
MEDIA_PORT=3051
MEDIA_DATABASE_URL=postgresql://collector:collector123@localhost:5435/cesi_media_test

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=collector-media-test

# ============================================
# Test Database Setup
# ============================================
# Create test databases:
#   docker exec -it postgres-auth psql -U collector -c "CREATE DATABASE cesi_auth_test;"
#   docker exec -it postgres-listing psql -U collector -c "CREATE DATABASE cesi_listing_test;"
#   docker exec -it postgres-moderation psql -U collector -c "CREATE DATABASE cesi_moderation_test;"
#   docker exec -it postgres-media psql -U collector -c "CREATE DATABASE cesi_media_test;"

# Run migrations:
#   npm run prisma:migrate:auth
#   npm run prisma:migrate:listing
#   npm run prisma:migrate:moderation
#   npm run prisma:migrate:media

# ============================================
# Notes
# ============================================
# 1. Test databases should be separate from development databases
# 2. Use different ports for test services to avoid conflicts
# 3. Test data is automatically cleaned up after each test suite
# 4. JWT keys can be simplified for testing (use symmetric keys)
# 5. Ensure all Docker services are running before tests:
#    docker-compose up -d
