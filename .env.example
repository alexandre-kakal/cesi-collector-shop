# ============================================================
# CESI COLLECTOR SHOP — Environment Variables Reference
# ============================================================
# Copy this file to apps/<service>/.env and fill in the values.
# Each service has its own .env file.

# ============================================================
# AUTH SERVICE (apps/auth/.env)
# ============================================================
AUTH_PORT=3010
AUTH_DATABASE_URL="postgresql://auth_user:auth_password@localhost:5432/auth_db?schema=public"
BETTER_AUTH_SECRET="change-me-to-a-random-64-char-secret"
BETTER_AUTH_URL="http://localhost:3010"

# JWT RS256 Keys (generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Redis (for session storage & JWT blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RabbitMQ
RABBITMQ_URL="amqp://rabbit_user:rabbit_password@localhost:5672/collector"

# ============================================================
# LISTING SERVICE (apps/listing/.env)
# ============================================================
LISTING_PORT=3020
LISTING_DATABASE_URL="postgresql://listing_user:listing_password@localhost:5433/listing_db?schema=public"

# JWT (only public key needed for verification)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# RabbitMQ
RABBITMQ_URL="amqp://rabbit_user:rabbit_password@localhost:5672/collector"

# ============================================================
# MODERATION SERVICE (apps/moderation/.env)
# ============================================================
MODERATION_PORT=3030
MODERATION_DATABASE_URL="postgresql://moderation_user:moderation_password@localhost:5434/moderation_db?schema=public"

# JWT (only public key needed for verification)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# RabbitMQ
RABBITMQ_URL="amqp://rabbit_user:rabbit_password@localhost:5672/collector"

# ============================================================
# MEDIA SERVICE (apps/media/.env)
# ============================================================
MEDIA_PORT=3050
MEDIA_DATABASE_URL="postgresql://media_user:media_password@localhost:5435/media_db?schema=public"

# JWT (only public key needed for verification)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# RabbitMQ
RABBITMQ_URL="amqp://rabbit_user:rabbit_password@localhost:5672/collector"

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET_NAME=collector-media

# ============================================================
# SHARED INFRASTRUCTURE (for docker-compose)
# ============================================================
# PostgreSQL Auth
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=auth_password
POSTGRES_AUTH_DB=auth_db

# PostgreSQL Listing
POSTGRES_LISTING_USER=listing_user
POSTGRES_LISTING_PASSWORD=listing_password
POSTGRES_LISTING_DB=listing_db

# PostgreSQL Moderation
POSTGRES_MODERATION_USER=moderation_user
POSTGRES_MODERATION_PASSWORD=moderation_password
POSTGRES_MODERATION_DB=moderation_db

# PostgreSQL Media
POSTGRES_MEDIA_USER=media_user
POSTGRES_MEDIA_PASSWORD=media_password
POSTGRES_MEDIA_DB=media_db

# Redis
REDIS_PASSWORD=redis_password

# RabbitMQ
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=rabbit_password
RABBITMQ_DEFAULT_VHOST=collector

# MinIO
MINIO_ROOT_USER=minio_access_key
MINIO_ROOT_PASSWORD=minio_secret_key
